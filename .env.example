# Copy to .env and fill in. Get a key at https://openrouter.ai/keys (free models need no credits).
OPENROUTER_API_KEY=
# Comma-separated: tried in order, next one on rate limit / error. ":free" models cost nothing.
OPENROUTER_MODEL=openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.8
LLM_TIMEOUT=90
# Responses are cached here, so reruns never spend quota and stay reproducible.
LLM_CACHE=data/llm_cache.db
