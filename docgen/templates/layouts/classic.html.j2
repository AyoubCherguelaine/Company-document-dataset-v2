{#- Classic: issuer top-left, title + meta top-right, parties side by side, totals bottom-right. -#}
{% extends "base.html.j2" %}
{% import "components.html.j2" as c with context %}

{% block header %}
  <div>
    {{ logo_svg(issuer, theme) }}
    {{ c.issuer_block(issuer, opts.show_contact) }}
  </div>
  <div class="a-right">
    <h1>{{ title }}</h1>
    {{ c.meta_table(meta_rows) }}
  </div>
{% endblock %}

{% block parties %}{{ c.parties_row(party_blocks, opts.show_contact) }}{% endblock %}

{% block items %}{% if doc.items %}{{ c.line_table(doc.items, columns) }}{% endif %}{% endblock %}

{% block summary %}
<section class="summary">
  <div>{% block summary_left %}{% if opts.show_bank %}{{ c.bank_block(issuer) }}{% endif %}{% endblock %}</div>
  {% if doc.totals %}{{ c.totals_table(doc.totals) }}{% elif doc.summary %}{{ c.summary_table(doc.summary) }}{% endif %}
</section>
{% endblock %}

{% block notes %}
  {% if opts.show_notes %}{{ c.notes_block(doc.notes) }}{% endif %}
  {% if opts.show_signature %}{{ c.signature_block() }}{% endif %}
{% endblock %}

{% block footer %}{% if ctext("footer") %}<div>{{ ctext("footer") }}</div>{% endif %}{{ issuer.name }} · {{ issuer.address.lines() | join(' · ') }}{% if issuer.tax_id %} · {{ issuer.tax_id }}{% endif %}{% endblock %}
